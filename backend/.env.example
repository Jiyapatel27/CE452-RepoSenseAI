# Copy this file to `.env` and fill in the values.
# NEVER commit the real .env file.

# --- Groq / LLM (Step 7) ---
# Free key from https://console.groq.com -> API Keys
GROQ_API_KEY=
# NOTE: Groq has retired its Llama chat models - "llama-3.3-70b-versatile" now
# fails with "model not found". gpt-oss-120b is the strongest chat model Groq
# currently serves. Check live availability with:
#   python -c "from groq import Groq; print([m.id for m in Groq().models.list().data])"
GROQ_MODEL=openai/gpt-oss-120b

# --- Step 11: conversational chat (optional overrides) ---
# Prior messages fed back to the model so follow-ups can resolve references.
# CHAT_HISTORY_TURNS=6
#
# Budget for rewriting a follow-up into a standalone question. Must be generous:
# gpt-oss is a REASONING model, so max_tokens covers its internal reasoning as
# well as the reply. At 120 the reasoning consumed the entire budget and the
# content came back EMPTY, silently disabling condensation.
# CONDENSE_MAX_TOKENS=512
#
# Model-specific. gpt-oss accepts low|medium|high and "low" roughly halves the
# reasoning tokens. Leave empty for models that reject the parameter.
# GROQ_REASONING_EFFORT=

# --- Qdrant (used in Step 5, can stay as-is for now) ---
QDRANT_URL=http://localhost:6333

# --- GitHub access ---
# Only needed for PRIVATE repositories. Public repos clone without it.
# Create one at: https://github.com/settings/tokens
#   - Fine-grained token: grant "Contents: Read-only" on the repos you need
#   - Classic token:      tick the "repo" scope
# Users can also send a token per request instead of setting it here.
GITHUB_TOKEN=

# --- Step 1: repository ingestion tuning (optional overrides) ---
# CLONE_TIMEOUT_SECONDS=300
# MAX_FILE_SIZE_BYTES=1000000
# MAX_FILES_PER_REPO=5000

# --- Step 4: embeddings (optional overrides) ---
# Runs locally via sentence-transformers. The model (~130 MB) is downloaded
# once on first use and cached by Hugging Face.
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_DEVICE=auto

# --- Step 3: chunking tuning (optional overrides) ---
# Size is in CHARACTERS. Keep CHUNK_SIZE at or below ~1500 so chunks stay
# inside the 512-token limit of the bge-small embedding model.
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# MIN_CHUNK_CHARS=40
